{
  "extends": ["next/core-web-vitals"],
  "rules": {
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": "off",
    "no-undef": "off"
  },
  "globals": {
    "React": "readonly",
    "JSX": "readonly",
    "globalThis": "readonly"
  },
  "overrides": [
    {
      "files": ["src/core/pdf/**"],
      "rules": { "jsx-a11y/alt-text": "off" }
    }
  ]
}